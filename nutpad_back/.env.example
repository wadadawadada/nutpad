# Local dev works with NO env at all (embedded Postgres in .data/pg, auto-generated dev mint seed).

PORT=8787
# Railway Postgres (reference variable): ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# REQUIRED in production. 32+ random bytes, hex:  openssl rand -hex 32   (back it up, losing it loses all keysets)
MINT_SEED=
# Comma-separated browser origins allowed to call the API, e.g. https://nutpad-front.up.railway.app
FRONTEND_ORIGIN=*
# Public URL of this API (used to bind login signatures). Optional behind Railway's proxy.
API_PUBLIC_URL=
# Nostr relays for the durable outbox (manifests, checkpoints)
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# Test faucet: mints sat ecash out of thin air. Only for demos, never with real funds.
DEMO_FAUCET=true
# Adds a short "demo" vault duration for testing
DEMO_MODE=true
DEMO_VAULT_SECONDS=120
RUN_WORKER=true

# ---- Lightning (real deposits/withdrawals). LN_BACKEND: none | fake (simulator) | nwc | lnbits
LN_BACKEND=none
# cashu: use a public Cashu mint as the Lightning treasury (no node needed), e.g. Mutinynet signet:
#   LN_BACKEND=cashu  LN_NETWORK=signet  CASHU_UPSTREAM_URL=https://cashu.mutinynet.com
CASHU_UPSTREAM_URL=
# nwc: your own Lightning wallet via Nostr Wallet Connect (NIP-47). Needs make_invoice, lookup_invoice, pay_invoice, get_balance.
NWC_URL=
# regtest | signet | testnet   (mainnet is refused unless ALLOW_MAINNET=true)
LN_NETWORK=testnet
# LNbits instance whose wallet is funded with TESTNET coins; use the wallet's ADMIN key
LNBITS_URL=
LNBITS_ADMIN_KEY=
LN_MAX_SATS=100000
# With a real backend set DEMO_FAUCET=false (the faucet creates unbacked sats)
